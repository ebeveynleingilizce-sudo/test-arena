# Local development needs no Firebase credentials; localhost defaults to emulator.
# For a LIVE build put the real project's WEB configuration in .env.production.local.
# VITE fields are public browser configuration, NEVER service account/private keys.
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
