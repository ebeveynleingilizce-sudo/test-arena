rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Separate full-quiz experiment; no per-question pre-completion award route.
    function teacher(t) { return request.auth != null && request.auth.uid == t && !exists(/databases/$(database)/documents/studentBindings/$(t))
      && get(/databases/$(database)/documents/roles/$(t)).data.role == 'teacher'; }
    function pupil(t,s) {
      let b = get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data;
      let p = get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data;
      return request.auth != null && b.teacherUid == t && b.studentId == s
        && p.status == 'active' && b.version == p.credentialVersion;
    }
    function ownClass(t,c) {
      let b = get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data;
      return pupil(t,b.studentId)
        && get(/databases/$(database)/documents/teachers/$(t)/students/$(b.studentId)).data.classId == c;
    }
    function gradeAllowed(t,s,g) {
      let p = get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data;
      return g == p.gradeLevel || (p.gradeLevel > 2 && g == p.gradeLevel - 1);
    }
    function session(t,s,id) {
      return get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)).data;
    }
    function template(id) { return get(/databases/$(database)/documents/quizTemplates/$(id)).data; }
    function knownQuestion(t,s,id,q) {
      let test = session(t,s,id);
      let pack = template(test.templateId);
      return test.status == 'active' && pack.active == true && q in pack.questionIds && gradeAllowed(t,s,pack.gradeLevel);
    }
    function grading(t,s,id,q) {
      // An immutable committed submission must predate any result probe.
      let answer = get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/submissions/$(q)).data;
      let test = session(t,s,id);
      let key = get(/databases/$(database)/documents/privateQuizKeys/$(test.templateId)/answers/$(q)).data;
      let d = request.resource.data;
      return d.skipped == (answer.selectedChoiceId == '')
        && d.isCorrect == (answer.selectedChoiceId != '' && answer.selectedChoiceId == key.correctOptionId);
    }
    function newAward(t,s,q) {
      let a = getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/awardedQuestions/$(q)).data;
      return !exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/awardedQuestions/$(q))
        && a.xp == 1 && a.awardedAt == request.time;
    }
    function inWeek(w) {
      let p = get(/databases/$(database)/documents/arenaWeeks/$(w)).data;
      return request.time >= p.startsAt && request.time < p.endsAt;
    }
    function completedInWeek(t,s,id,w) {
      let p = get(/databases/$(database)/documents/arenaWeeks/$(w)).data;
      let completedAt = session(t,s,id).completedAt;
      return completedAt >= p.startsAt && completedAt < p.endsAt;
    }
    match /roles/{uid} { allow get: if request.auth != null && request.auth.uid == uid; }
    match /studentBindings/{uid} { allow get: if request.auth != null && request.auth.uid == uid; }
    match /quizTemplates/{id} {
      allow get: if request.auth != null && (get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher'
        || (pupil(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                  get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId)
          && gradeAllowed(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                          get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId,resource.data.gradeLevel)));
    }
    match /questions/{q} { allow get: if request.auth != null && (get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher'
      || (pupil(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId)
        && gradeAllowed(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                        get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId,resource.data.gradeLevel))); }
    match /arenaWeeks/{w} { allow read: if request.auth != null; }
    match /teachers/{t}/students/{s} {
      allow get: if teacher(t) || pupil(t,s);
      match /quizzes/{id} {
        allow read: if teacher(t) || pupil(t,s);
        allow create: if pupil(t,s)
          && request.resource.data.keys().hasOnly(['templateId','classId','resolved','correct','wrong','blank','lastQuestionId','status','startedAt','completedAt'])
          && template(request.resource.data.templateId).active == true && template(request.resource.data.templateId).questionIds.size() >= 1 && template(request.resource.data.templateId).questionIds.size() <= 10
          && gradeAllowed(t,s,template(request.resource.data.templateId).gradeLevel)
          && request.resource.data.classId == get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId
          && request.resource.data.resolved == 0 && request.resource.data.correct == 0
          && request.resource.data.wrong == 0 && request.resource.data.blank == 0
          && request.resource.data.lastQuestionId == '' && request.resource.data.status == 'active'
          && request.resource.data.startedAt == request.time && request.resource.data.completedAt == null;
        allow update: if pupil(t,s) && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','correct','wrong','blank','lastQuestionId','status','completedAt'])
          && request.resource.data.lastQuestionId is string
          && !exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/results/$(request.resource.data.lastQuestionId))
          && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/results/$(request.resource.data.lastQuestionId)).data.gradedAt == request.time
          && request.resource.data.resolved == resource.data.resolved + 1 && request.resource.data.resolved <= template(resource.data.templateId).questionIds.size()
          && request.resource.data.correct == resource.data.correct + (getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/results/$(request.resource.data.lastQuestionId)).data.isCorrect ? 1 : 0)
          && request.resource.data.blank == resource.data.blank + (getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/results/$(request.resource.data.lastQuestionId)).data.skipped ? 1 : 0)
          && request.resource.data.wrong == request.resource.data.resolved - request.resource.data.correct - request.resource.data.blank
          && request.resource.data.status == (request.resource.data.resolved == template(resource.data.templateId).questionIds.size() ? 'completed' : 'active')
          && request.resource.data.completedAt == (request.resource.data.resolved == template(resource.data.templateId).questionIds.size() ? request.time : null);
        match /submissions/{q} {
          allow read: if teacher(t) || pupil(t,s);
          allow create: if pupil(t,s) && knownQuestion(t,s,id,q)
            && request.resource.data.keys().hasOnly(['selectedChoiceId','submittedAt'])
            && request.resource.data.submittedAt == request.time
            && (request.resource.data.selectedChoiceId == '' || request.resource.data.selectedChoiceId in
                template(session(t,s,id).templateId).choiceIdsByQuestionId[q]);
        }
        match /results/{q} {
          allow read: if teacher(t) || pupil(t,s);
          allow create: if pupil(t,s) && knownQuestion(t,s,id,q)
            && request.resource.data.keys().hasOnly(['isCorrect','skipped','gradedAt'])
            && request.resource.data.isCorrect is bool && request.resource.data.skipped is bool
            && request.resource.data.gradedAt == request.time && grading(t,s,id,q)
            && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)).data.lastQuestionId == q
            && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)).data.resolved == session(t,s,id).resolved + 1
            && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.lastResultSessionId == id
            && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.lastResultQuestionId == q
            && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.answeredCount == get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.answeredCount + (request.resource.data.skipped ? 0 : 1);
        }
      }
      match /awardedQuestions/{q} {
        allow read: if teacher(t) || pupil(t,s);
        allow create: if pupil(t,s)
          && request.resource.data.keys().hasOnly(['testSessionId','weekKey','xp','awardedAt'])
          && request.resource.data.xp == 1 && request.resource.data.awardedAt == request.time
          && completedInWeek(t,s,request.resource.data.testSessionId,request.resource.data.weekKey)
          && session(t,s,request.resource.data.testSessionId).status == 'completed' && template(session(t,s,request.resource.data.testSessionId).templateId).active == true
          && gradeAllowed(t,s,template(session(t,s,request.resource.data.testSessionId).templateId).gradeLevel)
          && get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.testSessionId)/results/$(q)).data.isCorrect == true
          && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.totalXP ==
              get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.totalXP + 1
          && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.lastAwardQuestionId == q
          && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/academicWeeks/$(request.resource.data.weekKey)).data.lastAwardQuestionId == q
          && getAfter(/databases/$(database)/documents/teachers/$(t)/classes/$(get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId)/leaderboard/$(s)).data.lastAwardQuestionId == q;
      }
      match /learning/{id} {
        allow read: if teacher(t) || pupil(t,s);
        allow update: if id == 'summary' && pupil(t,s)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalXP','academicXP','lastAwardQuestionId'])
          && newAward(t,s,request.resource.data.lastAwardQuestionId)
          && request.resource.data.totalXP == resource.data.totalXP + 1 && request.resource.data.academicXP == request.resource.data.totalXP;
      }
      match /academicWeeks/{w} {
        allow read: if teacher(t) || pupil(t,s);
        allow create, update: if pupil(t,s)
          && request.resource.data.keys().hasOnly(['academicXP','lastAwardQuestionId'])
          && newAward(t,s,request.resource.data.lastAwardQuestionId)
          && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/awardedQuestions/$(request.resource.data.lastAwardQuestionId)).data.weekKey == w
          && request.resource.data.academicXP == (exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/academicWeeks/$(w)) ? resource.data.academicXP + 1 : 1);
      }
    }
    match /teachers/{t}/classes/{c}/leaderboard/{s} {
      allow read: if teacher(t) || ownClass(t,c);
      allow update: if pupil(t,s) && ownClass(t,c)
        && request.resource.data.keys().hasOnly(['studentId','classId','displayName','academicXP','weeklyAcademicXP','weekKey','lastAwardQuestionId'])
        && request.resource.data.studentId == s && request.resource.data.classId == c
        && request.resource.data.displayName == get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.firstName + ' ' + get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.lastName
        && newAward(t,s,request.resource.data.lastAwardQuestionId)
        && inWeek(request.resource.data.weekKey)
        && request.resource.data.academicXP == getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.totalXP
        && request.resource.data.weeklyAcademicXP == (existsAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/academicWeeks/$(request.resource.data.weekKey))
          ? getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/academicWeeks/$(request.resource.data.weekKey)).data.academicXP : 0);
    }
    // Additive experiment only: combined with quiz.rules by the isolated tests.
    function ticket(code) { return get(/databases/$(database)/documents/codeTickets/$(code)).data; }
    function proof(uid) { return get(/databases/$(database)/documents/enrollmentProofs/$(uid)).data; }
    function activation(t,s,uid,v) {
      let p = proof(uid);
      let b = getAfter(/databases/$(database)/documents/studentBindings/$(uid)).data;
      return p.teacherUid == t && p.studentId == s && p.version == v
        && b.teacherUid == t && b.studentId == s && b.version == v;
    }
    match /teachers/{t}/classes/{c} {
      allow read: if teacher(t);
      allow create: if teacher(t) && request.resource.data.keys().hasOnly(['classId','className','defaultGradeLevel'])
        && request.resource.data.classId == c && request.resource.data.className is string && request.resource.data.className.size() > 0 && request.resource.data.className.size() <= 60 && request.resource.data.defaultGradeLevel >= 2
        && request.resource.data.defaultGradeLevel <= 12;
    }
    match /teachers/{t}/students/{s} {
      allow create: if teacher(t)
        && request.resource.data.keys().hasOnly(['teacherUid','studentId','classId','className','firstName','lastName','gradeLevel','status','credentialVersion'])
        && request.resource.data.teacherUid == t && request.resource.data.studentId == s
        && exists(/databases/$(database)/documents/teachers/$(t)/classes/$(request.resource.data.classId))
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 40
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 40
        && request.resource.data.className == get(/databases/$(database)/documents/teachers/$(t)/classes/$(request.resource.data.classId)).data.className
        && request.resource.data.gradeLevel >= 2 && request.resource.data.gradeLevel <= 12
        && request.resource.data.status == 'pending' && request.resource.data.credentialVersion == 0;
      allow update: if teacher(t)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','credentialVersion','authUid'])
        && request.resource.data.status == 'active'
        && request.resource.data.credentialVersion == resource.data.credentialVersion + 1
        && activation(t,s,request.resource.data.authUid,request.resource.data.credentialVersion);
      match /learning/{id} {
        allow create: if id == 'summary' && teacher(t)
          && get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.status == 'pending'
          && request.resource.data == {'totalXP':0,'academicXP':0,'lastAwardQuestionId':'','answeredCount':0,'correctCount':0,'wrongCount':0};
      }
    }
    match /teachers/{t}/classes/{c}/leaderboard/{s} {
      allow create: if teacher(t)
        && get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.status == 'pending'
        && get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId == c
        && request.resource.data == {'studentId':s,'classId':c,'displayName':get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.firstName + ' ' + get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.lastName,'academicXP':0,'weeklyAcademicXP':0,'weekKey':'','lastAwardQuestionId':''};
    }
    // Permanent reservations: changed email/deleted Auth user cannot recycle a code.
    match /codeTickets/{code} {
      allow get: if teacher(resource.data.teacherUid);
      allow create: if code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$')
        && teacher(request.resource.data.teacherUid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentId','version','email'])
        && request.resource.data.email == code.lower() + '@students.testarena.invalid'
        && request.resource.data.version == get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid)/students/$(request.resource.data.studentId)).data.credentialVersion + 1;
    }
    match /enrollmentProofs/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || teacher(resource.data.teacherUid));
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['teacherUid','studentId','version','code'])
        && ticket(request.resource.data.code).teacherUid == request.resource.data.teacherUid
        && ticket(request.resource.data.code).studentId == request.resource.data.studentId
        && ticket(request.resource.data.code).version == request.resource.data.version
        && request.auth.token.email == ticket(request.resource.data.code).email;
    }
    match /studentBindings/{uid} {
      allow create: if teacher(request.resource.data.teacherUid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentId','version'])
        && proof(uid).teacherUid == request.resource.data.teacherUid
        && proof(uid).studentId == request.resource.data.studentId && proof(uid).version == request.resource.data.version
        && getAfter(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid)/students/$(request.resource.data.studentId)).data.authUid == uid
        && getAfter(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid)/students/$(request.resource.data.studentId)).data.credentialVersion == request.resource.data.version;
    }
    match /roles/{uid} {
      allow create: if request.resource.data == {'role':'student'} && teacher(proof(uid).teacherUid)
        && getAfter(/databases/$(database)/documents/studentBindings/$(uid)).data.studentId == proof(uid).studentId;
    }


    match /teachers/{t}/classes/{c}/classMembers/{s} {
      allow read: if teacher(t);
      allow create, update: if teacher(t) && request.resource.data == {'studentId':s}
        && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId == c
        && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.status == 'active';
      allow delete: if teacher(t) && (getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId != c
        || getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.status == 'removed');
    }
    match /teachers/{t}/classes/{c}/leaderboard/{s} {
      allow create, update: if teacher(t)
        && get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId == c
        && get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.status == 'active'
        && request.resource.data.keys().hasOnly(['studentId','classId','displayName','academicXP','weeklyAcademicXP','weekKey','lastAwardQuestionId'])
        && request.resource.data.studentId == s && request.resource.data.classId == c
        && request.resource.data.displayName == get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.firstName + ' ' + get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.lastName
        && request.resource.data.lastAwardQuestionId == get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.lastAwardQuestionId
        && request.resource.data.academicXP == get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/learning/summary).data.totalXP
        && inWeek(request.resource.data.weekKey)
        && request.resource.data.weeklyAcademicXP == (exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/academicWeeks/$(request.resource.data.weekKey)) ? get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/academicWeeks/$(request.resource.data.weekKey)).data.academicXP : 0);
      allow delete: if teacher(t) && (getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.classId != c
        || getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.status == 'removed');
    }
    match /roles/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data == {'role':'teacher'}
        && request.auth.token.firebase.sign_in_provider in ['password','google.com']
        && !request.auth.token.email.matches('.*@students[.]testarena[.]invalid$')
        && !exists(/databases/$(database)/documents/studentBindings/$(uid));
    }
    match /teachers/{t} { allow read: if teacher(t); }
    match /clockSamples/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }
    match /sparkCatalog/{g} {
      allow get: if request.auth != null && (teacher(request.auth.uid)
        || (pupil(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                  get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId)
          && gradeAllowed(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                           get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId,int(g))));
    }
    match /teachers/{t}/students/{s} {
      allow list: if teacher(t);
      allow update: if teacher(t)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId','className','gradeLevel'])
        && request.resource.data.gradeLevel >= 2 && request.resource.data.gradeLevel <= 12
        && request.resource.data.className == get(/databases/$(database)/documents/teachers/$(t)/classes/$(request.resource.data.classId)).data.className;
      allow update: if teacher(t)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','credentialVersion'])
        && resource.data.status == 'active' && request.resource.data.status == 'removed'
        && request.resource.data.credentialVersion == resource.data.credentialVersion + 1;
      match /answerReceipts/{r} {
        allow read: if teacher(t) || pupil(t,s);
        allow create: if pupil(t,s)
          && request.resource.data.keys().hasOnly(['sessionId','templateId','questionId'])
          && r == request.resource.data.templateId + ':' + request.resource.data.questionId
          && knownQuestion(t,s,request.resource.data.sessionId,request.resource.data.questionId)
          && session(t,s,request.resource.data.sessionId).templateId == request.resource.data.templateId
          && (exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.sessionId)/submissions/$(request.resource.data.questionId))
            || getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.sessionId)/submissions/$(request.resource.data.questionId)).data.submittedAt == request.time);
      }
      match /learning/{id} {
        allow update: if id == 'summary' && pupil(t,s)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answeredCount','correctCount','wrongCount','lastResultSessionId','lastResultQuestionId'])
          && !exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.lastResultSessionId)/results/$(request.resource.data.lastResultQuestionId))
          && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.lastResultSessionId)/results/$(request.resource.data.lastResultQuestionId)).data.gradedAt == request.time
          && request.resource.data.answeredCount == resource.data.answeredCount + (getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.lastResultSessionId)/results/$(request.resource.data.lastResultQuestionId)).data.skipped ? 0 : 1)
          && request.resource.data.correctCount == resource.data.correctCount + (getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(request.resource.data.lastResultSessionId)/results/$(request.resource.data.lastResultQuestionId)).data.isCorrect ? 1 : 0)
          && request.resource.data.wrongCount == request.resource.data.answeredCount - request.resource.data.correctCount;
      }
      match /analytics/{id} { allow read: if teacher(t); }
      match /analyticsDimensions/{id} { allow read: if teacher(t); }
      match /testSessions/{id} {
        allow read: if teacher(t) || pupil(t,s);
        match /answers/{q} { allow read: if teacher(t) || pupil(t,s); }
      }
    }
    match /teachers/{t}/studentCodes/{s} {
      allow read: if teacher(t);
      allow create, update: if teacher(t)
        && request.resource.data.keys().hasOnly(['code','credentialVersion'])
        && ticket(request.resource.data.code).teacherUid == t && ticket(request.resource.data.code).studentId == s
        && ticket(request.resource.data.code).version == request.resource.data.credentialVersion
        && getAfter(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data.credentialVersion == request.resource.data.credentialVersion;
    }
    function receiptFor(t,s,q,pack) { let rid = pack + ':' + q; return get(/databases/$(database)/documents/teachers/$(t)/students/$(s)/answerReceipts/$(rid)).data; }
    match /privateQuizKeys/{pack}/answers/{q} {
      // Classroom Arena reads keys as a teacher; pupils still require a locked answer.
      allow get: if request.auth != null && teacher(request.auth.uid);
      allow get: if request.auth != null
        && pupil(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                 get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId)
        && receiptFor(get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.teacherUid,
                      get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId,q,pack).templateId == pack;
    }

    function duel(t,c,d) { return get(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duels/$(d)).data; }
    function availableDuel(t,c,s) {
      return exists(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duelSlots/$(s))
        ? expiredDuel(duel(t,c,get(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duelSlots/$(s)).data.duelId))
        : true;
    }
    function expiredDuel(d) { return d.status in ['declined','expired','completed']
      || (d.status == 'pending' && request.time >= d.createdAt + duration.value(60,'s'))
      || (d.status == 'active' && request.time >= d.acceptedAt + duration.value(310,'s')); }
    function duelPlayer(t,c,s,g) {
      let p = get(/databases/$(database)/documents/teachers/$(t)/students/$(s)).data;
      return p.status == 'active' && p.classId == c && gradeAllowed(t,s,g)
        && get(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/presence/$(s)).data.at > request.time - duration.value(75,'s');
    }
    match /teachers/{t}/classes/{c}/presence/{s} {
      allow read: if ownClass(t,c);
      allow create, update: if pupil(t,s) && ownClass(t,c)
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }
    match /teachers/{t}/classes/{c}/duelSlots/{s} {
      allow read: if ownClass(t,c);
      allow create, update: if ownClass(t,c) && availableDuel(t,c,s)
        && request.resource.data.keys().hasOnly(['duelId'])
        && getAfter(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duels/$(request.resource.data.duelId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duels/$(request.resource.data.duelId)).data.createdAt == request.time
        && s in getAfter(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duels/$(request.resource.data.duelId)).data.participants;
    }
    match /teachers/{t}/classes/{c}/duels/{d} {
      allow read: if ownClass(t,c) || teacher(t);
      allow create: if ownClass(t,c) && pupil(t,request.resource.data.from)
        && request.resource.data.keys().hasOnly(['participants','from','to','templateId','status','createdAt','acceptedAt'])
        && request.resource.data.participants == [request.resource.data.from,request.resource.data.to]
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.acceptedAt == null
        && template(request.resource.data.templateId).active == true && template(request.resource.data.templateId).questionIds.size() == 10
        && duelPlayer(t,c,request.resource.data.from,template(request.resource.data.templateId).gradeLevel)
        && duelPlayer(t,c,request.resource.data.to,template(request.resource.data.templateId).gradeLevel)
        && getAfter(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duelSlots/$(request.resource.data.from)).data.duelId == d
        && getAfter(/databases/$(database)/documents/teachers/$(t)/classes/$(c)/duelSlots/$(request.resource.data.to)).data.duelId == d;
      allow update: if ownClass(t,c) && pupil(t,resource.data.to) && resource.data.status == 'pending'
        && request.time < resource.data.createdAt + duration.value(60,'s')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt'])
        && ((request.resource.data.status == 'declined' && request.resource.data.acceptedAt == null)
          || (request.resource.data.status == 'active' && request.resource.data.acceptedAt == request.time
            && duelPlayer(t,c,resource.data.from,template(resource.data.templateId).gradeLevel)
            && duelPlayer(t,c,resource.data.to,template(resource.data.templateId).gradeLevel)));
      allow update: if ownClass(t,c)
        && get(/databases/$(database)/documents/studentBindings/$(request.auth.uid)).data.studentId in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'pending' && request.time >= resource.data.createdAt + duration.value(60,'s') && request.resource.data.status == 'expired')
          || (resource.data.status == 'active' && request.time >= resource.data.acceptedAt + duration.value(310,'s') && request.resource.data.status == 'completed')
          || (resource.data.status in ['completed','expired'] && request.resource.data == resource.data));
      match /answers/{a} {
        allow read: if ownClass(t,c) || teacher(t);
        allow create: if ownClass(t,c) && pupil(t,request.resource.data.studentId)
          && request.resource.data.studentId in duel(t,c,d).participants
          && validDuelAnswer(t,c,d,a);
      }
    }
    function validDuelAnswer(t,c,d,a) {
      let v = request.resource.data;
      let game = duel(t,c,d);
      let q = template(game.templateId).questionIds[v.index];
      let sid = d + '-' + v.studentId;
      let submission = get(/databases/$(database)/documents/teachers/$(t)/students/$(v.studentId)/quizzes/$(sid)/submissions/$(q)).data;
      let result = get(/databases/$(database)/documents/teachers/$(t)/students/$(v.studentId)/quizzes/$(sid)/results/$(q)).data;
      let start = game.acceptedAt + duration.value(10 + v.index * 30,'s');
      return v.keys().hasOnly(['studentId','index','isCorrect','submittedAt'])
        && v.index is int && v.index >= 0 && v.index < 10 && a == v.studentId + '-' + string(v.index)
        && game.status in ['active','completed'] && session(t,v.studentId,sid).templateId == game.templateId
        && v.isCorrect == result.isCorrect && v.submittedAt == submission.submittedAt
        && submission.submittedAt >= start && submission.submittedAt < start + duration.value(30,'s');
    }

    // Browser-reported observations: isolated and bounded; never used by XP rules.
    function behaviorNumber(n,max) { return n is int && n >= 0 && n <= max; }
    function behaviorList(v,max) {
      return v is list && v.size() == 10
        && behaviorNumber(v[0],max) && behaviorNumber(v[1],max)
        && behaviorNumber(v[2],max) && behaviorNumber(v[3],max)
        && behaviorNumber(v[4],max) && behaviorNumber(v[5],max)
        && behaviorNumber(v[6],max) && behaviorNumber(v[7],max)
        && behaviorNumber(v[8],max) && behaviorNumber(v[9],max);
    }
    function behaviorValid(v) {
      return v.keys().hasOnly(['streamId','revision','startedAt','updatedAt','visibleMs','hiddenMs','exitCount','questionMs','questionChanges'])
        && v.streamId is string && v.streamId.matches('[-A-Za-z0-9_]{1,64}')
        && behaviorNumber(v.revision,120) && v.revision >= 1
        && behaviorNumber(v.visibleMs,86400000) && behaviorNumber(v.hiddenMs,86400000)
        && v.visibleMs + v.hiddenMs <= 86400000
        && behaviorNumber(v.exitCount,10000)
        && behaviorList(v.questionMs,86400000) && behaviorList(v.questionChanges,10000)
        && v.updatedAt == request.time;
    }
    match /teachers/{t}/students/{s}/quizzes/{id}/behavior/{slot} {
      allow read: if teacher(t) || pupil(t,s);
      allow create, update: if pupil(t,s) && slot.matches('[0-7]')
        && exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id))
        && (session(t,s,id).status == 'active' || request.time < session(t,s,id).completedAt + duration.value(1,'h'))
        && behaviorValid(request.resource.data)
        && ((!exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/behavior/$(slot))
            && request.resource.data.revision == 1 && request.resource.data.startedAt == request.time)
          || (exists(/databases/$(database)/documents/teachers/$(t)/students/$(s)/quizzes/$(id)/behavior/$(slot))
            && request.resource.data.streamId == resource.data.streamId
            && request.resource.data.startedAt == resource.data.startedAt
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.visibleMs >= resource.data.visibleMs
            && request.resource.data.hiddenMs >= resource.data.hiddenMs
            && request.resource.data.exitCount >= resource.data.exitCount));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
