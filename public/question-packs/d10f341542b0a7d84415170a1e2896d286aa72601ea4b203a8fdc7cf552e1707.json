t-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q033","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"Ali’nin hangi özelliği öne çıkar?","content":"Metni dikkatle okuyunuz.\nAli, kütüphaneden aldığı kitabı bitirince zamanında geri verdi.","choices":[{"choiceId":"a","text":"Korkaklığı"},{"choiceId":"b","text":"Sorumluluğu"},{"choiceId":"c","text":"Kararsızlığı"},{"choiceId":"d","text":"Sabırsızlığı"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q034","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"“Neşeyle” kelimesinin yerine hangisi kullanılabilir?","content":"Metni dikkatle okuyunuz.\n“Çocuklar parkta neşeyle oynuyordu.”","choices":[{"choiceId":"a","text":"Öfkeyle"},{"choiceId":"b","text":"Korkuyla"},{"choiceId":"c","text":"Üzüntüyle"},{"choiceId":"d","text":"Sevinçle"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q035","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"“Büyük” kelimesinin zıt anlamlısı hangisidir?","content":"Metni dikkatle okuyunuz.\n“Küçük kedi, büyük ağacın gölgesinde uyudu.”","choices":[{"choiceId":"a","text":"Yüksek"},{"choiceId":"b","text":"Uzun"},{"choiceId":"c","text":"Geniş"},{"choiceId":"d","text":"Küçük"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q036","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"Metnin konusu nedir?","content":"Metni dikkatle okuyunuz.\nDuru, okul bahçesindeki susuz çiçekleri görünce onları suladı.","choices":[{"choiceId":"a","text":"Bitkilerin bakımı"},{"choiceId":"b","text":"Spor yarışmaları"},{"choiceId":"c","text":"Okul servisi"},{"choiceId":"d","text":"Kitap seçimi"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q037","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"Metne en uygun başlık hangisidir?","content":"Metni dikkatle okuyunuz.\nBir grup çocuk kullanılmayan kutuları değerlendirerek kuşlar için yuva yaptı.","choices":[{"choiceId":"a","text":"Kuşlara Yuva"},{"choiceId":"b","text":"Yağmurlu Gün"},{"choiceId":"c","text":"Yeni Bisiklet"},{"choiceId":"d","text":"Kayıp Defter"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q038","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"Bu cümlede hangi noktalama işareti cümle sonunda doğru kullanılmıştır?","content":"Metni dikkatle okuyunuz.\n“Deniz, arkadaşını görünce ona seslendi.”","choices":[{"choiceId":"a","text":"Ünlem"},{"choiceId":"b","text":"Nokta"},{"choiceId":"c","text":"Soru işareti"},{"choiceId":"d","text":"Virgül"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q039","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"Bu cümledeki olayın özelliği nedir?","content":"Metni dikkatle okuyunuz.\n“Oyuncak tren gece yarısı konuşmaya başladı.”","choices":[{"choiceId":"a","text":"Tarihîdir"},{"choiceId":"b","text":"Gerçektir"},{"choiceId":"c","text":"Bilimseldir"},{"choiceId":"d","text":"Hayalîdir"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g4-turkce-u1-q040","gradeLevel":4,"subject":"turkce","unitId":"g4-turkce-tema-1","topic":"g4-turkce-tema-1","topicName":"1. Tema — Çocuk Dünyası","questionText":"Efe kimden yardım istemiştir?","content":"Metni dikkatle okuyunuz.\n“Efe, kumdan kale yaparken kardeşinden yardım istedi.”","choices":[{"choiceId":"a","text":"Öğretmeninden"},{"choiceId":"b","text":"Kardeşinden"},{"choiceId":"c","text":"Komşusundan"},{"choiceId":"d","text":"Babasından"}],"sourceDatasetId":"test-arena-curriculum-grade-4-tr-2026-2027","status":"published","isDemo":false}]}