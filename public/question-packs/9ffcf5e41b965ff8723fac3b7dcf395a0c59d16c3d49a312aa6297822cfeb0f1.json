sı"},{"choiceId":"d","text":"Kitaplığın kapısının açılmaması"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q022-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-okuma","topicName":"Değerlerimizle Varız","questionText":"Hangi cümle metindeki olayları doğru özetler?","content":"Eylül, sınıf çiçeğini sulayacaktı. Toprağın hâlâ ıslak olduğunu gördü. O gün su vermedi. Ertesi gün toprak kuruyunca çiçeği suladı.","choices":[{"choiceId":"a","text":"Eylül çiçeğe her gün aynı miktarda su verdi."},{"choiceId":"b","text":"Eylül toprağı kontrol ederek çiçeği gerektiğinde suladı."},{"choiceId":"c","text":"Eylül çiçeği sulamayı tamamen bıraktı."},{"choiceId":"d","text":"Eylül ıslak toprağa hemen su döktü."}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q023-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-okuma","topicName":"Değerlerimizle Varız","questionText":"Metindeki hangi olay, Umut’un verdiği sözü yerine getirdiğini gösterir?","content":"Umut, arkadaşına cuma günü kitabını getireceğini söyledi. Perşembe akşamı kitabı çantasına koydu. Cuma günü kitabı arkadaşına verdi.","choices":[{"choiceId":"a","text":"Perşembe günü okuldan çıkması"},{"choiceId":"b","text":"Arkadaşının kitap okumayı sevmesi"},{"choiceId":"c","text":"Cuma günü kitabı arkadaşına vermesi"},{"choiceId":"d","text":"Kitabın çantasında ağır gelmesi"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q024-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-okuma","topicName":"Değerlerimizle Varız","questionText":"Hangi başlık metnin bütününe en uygundur?","content":"Zeynep ve Efe resim yapıyordu. Zeynep’in mavi kalemi, Efe’nin kırmızı kalemi yoktu. Kalemlerini birbirlerine vererek resimlerini tamamladılar.","choices":[{"choiceId":"a","text":"Kaybolan Resimler"},{"choiceId":"b","text":"Kırılan Kalemler"},{"choiceId":"c","text":"Boş Kalan Sayfalar"},{"choiceId":"d","text":"Paylaşınca Tamamlandı"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q025-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-okuma","topicName":"Değerlerimizle Varız","questionText":"Oya’nın metinde yaptığı işlemler hangi sıradadır?","content":"Oya, sınıf panosu için bir yazı hazırladı. Yazıyı okuyunca bazı cümleleri anlamakta zorlandı. Cümleleri düzeltti ve yazısını yeniden okudu.","choices":[{"choiceId":"a","text":"Yazma → okuma → düzeltme → yeniden okuma"},{"choiceId":"b","text":"Okuma → düzeltme → yazma → yeniden okuma"},{"choiceId":"c","text":"Düzeltme → yazma → yeniden okuma → okuma"},{"choiceId":"d","text":"Yazma → düzeltme → okuma → yazma"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q026-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-okuma","topicName":"Değerlerimizle Varız","questionText":"Bu metinde en çok hangi konunun anlatılması beklenir?","content":"Bir metnin başlığı “Paylaşılan Oyuncak”tır.","choices":[{"choiceId":"a","text":"Bir ağacın büyümesi"},{"choiceId":"b","text":"Bir oyuncağı birlikte kullanmak"},{"choiceId":"c","text":"Bir trenin yolculuğu"},{"choiceId":"d","text":"Bir yemeğin pişirilmesi"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q027-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-okuma","topicName":"Değerlerimizle Varız","questionText":"Hangi olayın bu metinde yer alması daha olasıdır?","content":"“Sözümü Tuttum” başlıklı bir metni okuyacaksın.","choices":[{"choiceId":"a","text":"Bir kuşun yuva kurması"},{"choiceId":"b","text":"Yağmurun bütün gün sürmesi"},{"choiceId":"c","text":"Bir çocuğun söz verdiği işi yapması"},{"choiceId":"d","text":"Bir çocuğun rüya görmesi"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q028-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-degerlerimizle-variz","topicName":"Değerlerimizle Varız","questionText":"Bu cümlelerde “teşekkür etmek” hangi anlama gelir?","content":"“Arkadaşım bana yardım etti. Ona teşekkür ettim.”","choices":[{"choiceId":"a","text":"Bir işin yapılmasını yasaklamak"},{"choiceId":"b","text":"Karşısındaki kişiyi uyarmak"},{"choiceId":"c","text":"Birinden izin istemek"},{"choiceId":"d","text":"Yapılan iyilik için memnuniyetini söylemek"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q029-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkce-degerlerimizle-variz","topic":"g2-turkce-degerlerimizle-variz","topicName":"Değerlerimizle Varız","questionText":"“Ödünç almak” bu cümlede ne demektir?","content":"“Ece, ödünç aldığı kitabı sahibine geri verdi.”","choices":[{"choiceId":"a","text":"Sonra geri vermek üzere almak"},{"choiceId":"b","text":"Parasını ödeyerek satın almak"},{"choiceId":"c","text":"Sahibinden habersiz almak"},{"choiceId":"d","text":"Bir daha vermemek üzere almak"}],"sourceDatasetId":"test-arena-curriculum-grade-2-tr-2026-2027","status":"published","isDemo":false},{"questionId":"g2-turkce-degerlerimizle-variz-q030-content-v2","gradeLevel":2,"subject":"turkce","unitId":"g2-turkc